# ── Telegram app credentials ────────────────────────────────────────────
# Get these from https://my.telegram.org → API development tools
BOOKLINK_API_ID=12345678
BOOKLINK_API_HASH=your_api_hash_here

# ── Librarian account session ───────────────────────────────────────────
# Run: python3 make_session.py phone <number>  →  sign-in <code>
# Paste the printed string here.
BOOKLINK_SESSION=

# Optional: a second librarian account (leave blank to disable).
# Run make_session.py again with the other account and paste its string here.
BOOKLINK_SESSION_NEW=

# ── Server ──────────────────────────────────────────────────────────────
BOOKLINK_PORT=8094
BOOKLINK_HOST=127.0.0.1
# The public base URL your links should use (your domain + reverse proxy).
BOOKLINK_BASE=http://127.0.0.1:8094
# Optional: a secret to sign links with (private links). Blank = public links.
BOOKLINK_SECRET=

# ── Cache ───────────────────────────────────────────────────────────────
BOOKLINK_CACHE_DIR=/opt/booklink/cache
# Seconds before a cached file is dropped (24h).
BOOKLINK_CACHE_MAX_AGE=86400
# Total cache size in bytes before the oldest entries are dropped (18 GB).
BOOKLINK_CACHE_MAX_SIZE=19327352832

# ── Concurrency ─────────────────────────────────────────────────────────
# Simultaneous downloads. Telegram throttles per account, so more parallel
# downloads mostly just split the same bandwidth.
BOOKLINK_MAX_DOWNLOADS=4
# The legacy account is throttled harder — keep it serial.
BOOKLINK_MAX_DOWNLOADS_OLD=1

# ── Fetch routing ───────────────────────────────────────────────────────
# Which account fetches files: old | new | auto.
# "auto" picks an account that has Telegram Premium and re-checks periodically,
# because a non-Premium account is throttled hard enough to stall the pipeline.
BOOKLINK_DOWNLOAD_VIA=auto

# ── Link-only chats ─────────────────────────────────────────────────────
# Chat ids (comma-separated) that get a link but are never cached or uploaded
# to the public copy tier — e.g. high-volume catalog feeds.
BOOKLINK_NO_PRECACHE_CHATS=

# ── Group intake ────────────────────────────────────────────────────────
# Group ids (comma-separated) where posts are treated as first-class sends.
# Groups share message ids, so either librarian account can fetch from one —
# posts here are worked by both accounts instead of just one.
# Do NOT also list these in BOOKLINK_NO_PRECACHE_CHATS.
BOOKLINK_GROUP_CHATS=

# ── Public copy tier (optional) ─────────────────────────────────────────
# A reader download normally comes from the cache or straight from Telegram,
# which puts the load on this box and on Telegram's flood limits. A public copy
# is the same book rsynced to a box you already rent, and /b/ then redirects
# readers there — the link is unchanged, the bandwidth just moves.
#
# All three (plus BASE) must be set or the tier is off. With it off, links still
# work; they just always serve from cache/Telegram.
# Public URL of the directory the copies are served from.
BOOKLINK_ULTRA_BASE=
# rsync/ssh target, e.g. user@host.
BOOKLINK_ULTRA_SSH=
# Private key readable BY THE SERVICE USER — not root's.
BOOKLINK_ULTRA_KEY=
# Directory on the remote box, relative to its home.
BOOKLINK_ULTRA_DIR=www/books
# Where the copy map (public URL + hit counter per book) is kept.
BOOKLINK_ULTRA_MAP=/opt/booklink/ultra_map.json

# ── Dashboard (optional) ────────────────────────────────────────────────
# A read-only page of the public copies: name, size, times taken, when added,
# when last taken, and the /b/ link. Only GET clicks on a link count as a take.
# It is a full catalogue, so it is never served without login — set both, or the
# route answers 404. Meant to be shared with a handful of people, over basic
# auth, so they can see a link has landed before they post it.
BOOKLINK_STATUS_USER=
BOOKLINK_STATUS_PASS=
# Optional ?k= key, for a bookmark or a quick curl.
BOOKLINK_STATUS_KEY=

# ── Alerts ──────────────────────────────────────────────────────────────
# Chat username to ping when free disk on / drops below the threshold.
BOOKLINK_ALERT_CHAT=
BOOKLINK_DISK_ALERT_MB=5120
# Don't re-alert more often than this (seconds).
BOOKLINK_DISK_ALERT_COOLDOWN=14400

# NOTE: no inline "#" comments after values — systemd's EnvironmentFile parser
# does not strip them, and you'll get the comment as part of the value.
